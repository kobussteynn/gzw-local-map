{
  "name": "personal-gzw-tac-map",
  "private": true,
  "version": "1.1.2",
  "description": "Local personal mirror of the public GZW Tac Map client, assets and APIs",
  "scripts": {
    "start": "python server.py",
    "dev": "python server.py",
    "check": "python -m unittest discover -s tests -v && node --test tests/planner.test.mjs tests/location-filter.test.mjs",
    "desktop": "electron .",
    "build:backend": "node desktop/build-backend.cjs",
    "build:win": "npm run build:backend && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.cjs",
  "author": "kobussteynn",
  "build": {
    "appId": "com.kobussteynn.gzwlocalmap",
    "productName": "GZW Tac Map",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/mission-smoke.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/gzw-map-server",
        "to": "backend"
      },
      {
        "from": "snapshot",
        "to": "map/snapshot"
      },
      {
        "from": "data",
        "to": "map/data"
      },
      {
        "from": "local",
        "to": "map/local"
      },
      {
        "from": "desktop/app.ico",
        "to": "map/artifacts/desktop-icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/app.ico",
      "signExecutable": false,
      "artifactName": "GZW-Tac-Map-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GZW Tac Map",
      "deleteAppDataOnUninstall": false
    }
  }
}
